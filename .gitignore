# Rust 构建产物
target/

# 内核镜像与磁盘镜像
kernel-rv
kernel-la
*.img
*.bin
sdcard*

# QEMU / 调试输出
*.log
qemu-*.out

# 开发笔记，单独同步，不进入项目仓库
notes/

# 编辑器与系统文件
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

__pycache__/

# 官方评测器本地克隆与下载缓存（make test-setup 生成）
.cache/

# vendor 解压产物与运行时 CARGO_HOME（构建时由 vendor.tar.xz 生成）
vendor/
.cargo-home/
